<%- include("partials/header.ejs") %>

<div class="col-lg-8 side-widget">
    <!-- Table widget-->
    <table class="table align-middle mb-0 bg-white">
        <thead class="bg-light">
            <tr>
                <th>Name</th>
                <th>Title</th>
            </tr>
        </thead>
        <tbody>
            <% for (const [key, subjectID] of Object.entries(data).reverse()) { %>
                <tr>
                    <td>
                        <div class="d-flex align-items-center">
                            <img src="https://robohash.org/<%= subjectID.name %>" alt=""
                                style="width: 45px; height: 45px" class="rounded-circle" />
                            <div class="ms-3">
                                <p class="fw-bold mb-1">
                                    <%= subjectID.name %>
                                </p>
                            </div>
                        </div>
                    </td>
                    <td>
                        <a href="/<%= subjectID.id %>"
                            class="fs-5 fw-normal mb-1 link-underline link-underline-opacity-0 link-underline-opacity-75-hover">
                            <%= subjectID.subject %>
                        </a>
                        <p class="text-muted mb-0">
                            <%= subjectID.description %>
                        </p>
                    </td>
                    <% } %>
                </tr>
        </tbody>
    </table>
</div>

<%- include("partials/footer.ejs") %>