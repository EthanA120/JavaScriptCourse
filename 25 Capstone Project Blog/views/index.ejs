<%- include("partials/header.ejs") %>
    <!-- Page content-->
    <div class="container mt-5">
        <div class="row">
            <div class="col-lg-8">
                <!-- Post content-->
                <% if (url==='/' ) { %>
                    <%- include("partials/home.ejs") %>
                        <% } else { %>
                            <article>
                                <!-- Post header-->
                                <header class="mb-4">
                                    <!-- Post title-->
                                    <h1 class="fw-bolder mb-1">
                                        <%= subject.subject %>
                                    </h1>
                                    <!-- Post meta content-->
                                    <div class="text-muted fst-italic mb-2">Posted on <%= subject.date %>
                                    </div>
                                </header>
                                <!-- Post content-->
                                <section class="mb-5">
                                    <p class="fs-5 mb-4">
                                        <%= subject.text %>
                                    </p>
                                </section>
                            </article>
                            <% } %>
            </div>

            <!-- Side widgets-->
            <div class="col-lg-4 side-widget">
                <!-- Table widget-->
                <table class="table align-middle mb-0 bg-white">
                    <thead class="bg-light">
                        <tr>
                            <th>Name</th>
                            <th>Title</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% for (const [key, subjectID] of Object.entries(data).slice(-5).reverse()) { %>
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img src="https://robohash.org/<%= subjectID.name %>" alt=""
                                            style="width: 45px; height: 45px" class="rounded-circle" />
                                        <div class="ms-3">
                                            <p class="fw-bold mb-1">
                                                <%= subjectID.name %>
                                            </p>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <a href="/<%= subjectID.id %>"
                                        class="fs-5 fw-normal mb-1 link-underline link-underline-opacity-0 link-underline-opacity-75-hover">
                                        <%= subjectID.subject %>
                                    </a>
                                    <p class="text-muted mb-0">
                                        <%= subjectID.description %>
                                    </p>
                                </td>
                                <% } %>
                            </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <%- include("partials/footer.ejs") %>